# ── Site (Vite). Public values only: they end up in the browser bundle. ──
# Local: values from `npx supabase status`. Cloud: Vercel → Environment Variables.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key. Safe in the browser: RLS and grants do the guarding.
VITE_SUPABASE_ANON_KEY=
# Public half of the VAPID pair (`pnpm vapid:generate`). Empty = reminders via calendar only.
VITE_VAPID_PUBLIC_KEY=

# ── Pipeline scripts: copy to .env.publish (git-ignored). NEVER put these into VITE_* ──
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=<service_role key, server only>
# SUPABASE_DB_PASSWORD=<database password, for `supabase db push` / cloud:configure>
# SUPABASE_PROJECT_REF=<ref>
# SITE_URL=https://<your-project>.vercel.app
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=<server only: goes to `supabase secrets set`>

# Edge Function secrets (LLM_*, VAPID_*, ALLOWED_ORIGINS): see supabase/functions/.env.example
