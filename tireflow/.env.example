# ── Public (sent to the browser) ─────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (sb_publishable_…). Safe in the browser: RLS protects all data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server only (never prefix with NEXT_PUBLIC_) ─────────────
# Secret key (sb_secret_…). Used only for sending auth invites from server actions.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=

# ── Optional integrations (leave empty to use the test adapter) ──
# Set these as Supabase Edge Function secrets, not in Vercel:
#   supabase secrets set RESEND_API_KEY=… TWILIO_ACCOUNT_SID=… TWILIO_AUTH_TOKEN=… TWILIO_FROM=…
#   supabase secrets set TELEGRAM_BOT_TOKEN=… WHATSAPP_TOKEN=… WHATSAPP_PHONE_ID=…
# AI assistant (server-side only, optional module):
AI_GATEWAY_API_KEY=
