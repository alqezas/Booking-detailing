# Server-only secrets for Edge Functions (local: copy to supabase/functions/.env;
# cloud: `supabase secrets set --env-file supabase/functions/.env`).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# auto | tools | json  (json for providers without tool calling)
LLM_TOOL_MODE=auto
LLM_DAILY_TOKENS_PER_TENANT=200000
LLM_DAILY_TOKENS_GLOBAL=2000000
# pnpm vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Comma-separated site origins allowed to call the functions (empty = any)
ALLOWED_ORIGINS=
