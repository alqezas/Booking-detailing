# ── Public frontend variables (bundled into the browser build; NOT secrets) ──
# Supabase project URL and the publishable/anon key (RLS and grants protect the data).
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=
# Public site origin for canonical URLs, sitemap and Open Graph (e.g. https://greentouch.com.ua)
VITE_SITE_URL=http://localhost:4180

# ── Server secrets live elsewhere ──
# Edge Function secrets: supabase/functions/.env.example (MONO_TOKEN, NP_API_KEY, ORDER_TOKEN_SECRET, JOBS_SECRET…)
# Never put the service role key or any of those into VITE_* variables.
