# Server-only secrets for Edge Functions. Never put these in the frontend.
# Local: copy to supabase/functions/.env  ·  Cloud: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are provided by the platform.)

# Public site origin: LiqPay result_url target and CORS allowlist
SITE_URL=http://localhost:4180
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4180

# HMAC secret for guest order tokens (openssl rand -base64 32)
ORDER_TOKEN_SECRET=
# Shared secret pg_cron sends to the jobs function (store the same value in Vault: gt_jobs_secret)
JOBS_SECRET=

# LiqPay (https://www.liqpay.ua/en/adminbusiness → API): public and private key of the shop
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_API_URL=https://www.liqpay.ua
# sha3-256 (current docs) or sha1 (older merchant accounts)
LIQPAY_SIGNATURE_ALGO=sha3-256
# 1 = test payments (sandbox); remove for real payments
LIQPAY_SANDBOX=
# defaults to $SUPABASE_URL/functions/v1/liqpay-callback
LIQPAY_CALLBACK_URL=
# defaults to $LIQPAY_API_URL/api/3/checkout (where the browser posts the payment form)
LIQPAY_CHECKOUT_URL=
# How long one payment page stays valid, minutes (default 1440 = 24 h)
PAYMENT_VALIDITY_MINUTES=1440

# Nova Poshta API 2.0 key (https://developers.novaposhta.ua/)
NP_API_KEY=
NP_API_URL=https://api.novaposhta.ua/v2.0/json/

# Optional owner notification of paid orders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
