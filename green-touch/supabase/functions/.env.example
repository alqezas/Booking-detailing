# Server-only secrets for Edge Functions. Never put these in the frontend.
# Local: copy to supabase/functions/.env  ·  Cloud: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are provided by the platform.)

# Public site origin: mono redirect target and CORS allowlist
SITE_URL=http://localhost:4180
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:4180

# HMAC secret for guest order tokens (openssl rand -base64 32)
ORDER_TOKEN_SECRET=
# Shared secret pg_cron sends to the jobs function (store the same value in Vault: gt_jobs_secret)
JOBS_SECRET=

# plata by mono: X-Token from https://web.monobank.ua (production) or the test token from https://api.monobank.ua/
MONO_TOKEN=
MONO_API_URL=https://api.monobank.ua
# defaults to $SUPABASE_URL/functions/v1/mono-webhook
MONO_WEBHOOK_URL=

# How long one mono invoice stays payable, minutes (default 1440 = 24 h)
PAYMENT_VALIDITY_MINUTES=1440

# Nova Poshta API 2.0 key (https://developers.novaposhta.ua/)
NP_API_KEY=
NP_API_URL=https://api.novaposhta.ua/v2.0/json/

# Optional owner notification of paid orders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Order emails to buyers (optional). Gmail: the shop address + a 16-character app password.
SMTP_USER=
SMTP_PASS=
